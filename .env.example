# =============================================================
# .env.example — Hiver SDE Intern Assignment
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.
# =============================================================

# --- LLM Provider Keys ---
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# --- Hardware / Runtime ---
# Set to "cuda" if GPU is available, "cpu" otherwise
DEVICE=cuda

# Must be float32 — no bf16 (Kaggle P100 is sm_60, no bf16 support)
DTYPE=float32

# --- Budget Control ---
# Hard daily call limit per provider (gateway will refuse past this)
BUDGET_PER_DAY=250

# --- Paths (leave defaults unless you move the dataset) ---
DATA_RAW_PATH=data/raw/twcs.csv
CACHE_DIR=.cache/llm
